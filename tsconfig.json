{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "module": "esnext",
    "target": "es2017",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/src/*": ["./src/*"],
      "@/hooks/*": ["./hooks/*"]
    },
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/types/env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
