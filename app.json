{
  "expo": {
    "name": "HVACPro",
    "slug": "hvacpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cbollinger.hvacpro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.cbollinger.hvacpro"
    },
    "scheme": "hvacpro",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://xwlyiqsmuhdgwvibmdtb.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh3bHlpcXNtdWhkZ3d2aWJtZHRiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzkyNDU4MDksImV4cCI6MjA1NDgyMTgwOX0.K9v5gmIgCygtxmwGA_eyI3TkvwhDWmTBCa47FAZYycU"
    },
    "newArchEnabled": true,
    "jsEngine": "hermes"
  }
} 